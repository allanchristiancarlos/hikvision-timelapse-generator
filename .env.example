# Copy this file to .env and fill in your values.
# Do not commit .env.

# Required for run_capture_daemon.py and capture_and_render.py
RTSP_HOST=your_nvr_host_or_ip
RTSP_USERNAME=your_username
RTSP_PASSWORD=your_password

# Optional RTSP tuning
RTSP_TRACK=801
RTSP_TRANSPORT=tcp

# Daily pipeline schedule and extraction config
PIPELINE_TZ=Asia/Manila
PIPELINE_START_DATE=2026-10-15
PIPELINE_RUN_AT=00:10
# For test mode, uncomment to run every N minutes instead of daily run time
# PIPELINE_EVERY_MINUTES=15

PIPELINE_FRAMES_PER_DAY=48
PIPELINE_WINDOW_SECONDS=4
PIPELINE_CLIP_SECONDS=1.0
PIPELINE_CONNECT_TIMEOUT_SECONDS=5.0
PIPELINE_DELAY_SECONDS=1.0
PIPELINE_PARALLEL_JOBS=1

PIPELINE_FRAMES_DIR=./screenshots
PIPELINE_VIDEO_OUTPUT=./screenshots/timelapse.mp4
PIPELINE_VIDEO_FPS=24
PIPELINE_STATE_FILE=./screenshots/.extract_state.json
PIPELINE_SCHEDULER_STATE=./screenshots/.daily_pipeline_state.json
PIPELINE_CAPTURE_SCRIPT=./src/capture_and_render.py

# Optional capture defaults for capture_and_render.py
HIKVISION_CHANNEL=1
HIKVISION_INTERVAL_HOURS=1.0
HIKVISION_OUTPUT_DIR=./screenshots

# Optional capture_and_render.py extraction defaults
# EXTRACT_DATE=2026-10-15:2026-10-31
# EXTRACT_TIME=12:00
# EXTRACT_INTERVAL_HOURS=1
# EXTRACT_FRAME_OFFSET_SECONDS=0.0
